.plan-bg {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.plan-header {
  margin-bottom: 28rpx;
}
.plan-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E2D;
  display: block;
  margin-bottom: 8rpx;
}
.plan-desc {
  font-size: 26rpx;
  color: #8A9B8B;
}

/* 当前目标展示 */
.goal-card {
  background: rgba(255,255,255,0.62);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 4rpx 20rpx rgba(46,125,50,0.06);
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.goal-label {
  font-size: 26rpx;
  color: #8A9B8B;
  margin-bottom: 12rpx;
}
.goal-display {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.goal-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1;
}
.goal-unit {
  font-size: 28rpx;
  font-weight: 500;
}
.goal-hint {
  font-size: 22rpx;
  color: #B0B8B0;
}

/* 快速选择 */
.options-card {
  background: rgba(255,255,255,0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.options-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E2D;
  display: block;
  margin-bottom: 20rpx;
}
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.option-btn {
  padding: 18rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.04);
}
.option-btn:active { opacity: 0.7; }
.option-btn.active { box-shadow: 0 4rpx 16rpx rgba(46,125,50,0.15); }
.option-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #4A5B4B;
}

/* 自定义输入 */
.custom-card {
  background: rgba(255,255,255,0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  padding: 24rpx 28rpx;
}
.custom-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E2D;
  display: block;
  margin-bottom: 16rpx;
}
.custom-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.03);
  margin-bottom: 20rpx;
}
.custom-input {
  flex: 1;
  font-size: 32rpx;
  color: #2C3E2D;
  font-weight: 600;
}
.custom-unit {
  font-size: 26rpx;
  color: #8A9B8B;
  flex-shrink: 0;
}
.custom-save {
  padding: 20rpx 0;
  border-radius: 20rpx;
  text-align: center;
}
.custom-save:active { opacity: 0.85; }
.custom-save-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
