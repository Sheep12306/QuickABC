/* 打卡日历 - 玻璃拟态 */

.record-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

/* 日历头部 */
.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 20rpx;
}

.month-btn {
  font-size: 32rpx;
  color: #8A9B8B;
  padding: 8rpx 20rpx;
  background: transparent;
  border: none;
}

.current-month {
  font-size: 32rpx;
  color: #2C3E2D;
  font-weight: 600;
}

/* 星期头部 */
.week-header {
  display: flex;
  padding: 12rpx 0;
}

.week-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8A9B8B;
  font-weight: 500;
}

/* 日历主体 */
.calendar-body {
  display: flex;
  flex-wrap: wrap;
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
  padding: 8rpx 0;
}

.date-item {
  width: calc(100% / 7);
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.date-text {
  font-size: 28rpx;
  color: #2C3E2D;
  padding: 10rpx;
  border-radius: 50%;
}

.not-current {
  color: #CCCFCC;
  pointer-events: none;
}

.check-in {
  font-weight: bold;
}

.selected {
  color: #FFFFFF !important;
}

.check-mark {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 18rpx;
}

/* 详情卡片 */
.detail-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.06);
  margin-top: 20rpx;
  padding: 32rpx 28rpx;
  text-align: center;
}

.detail-title {
  font-size: 28rpx;
  color: #2C3E2D;
  margin-bottom: 16rpx;
  display: block;
}

.detail-content {
  font-size: 32rpx;
  font-weight: 500;
}
