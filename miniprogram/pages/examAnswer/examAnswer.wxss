.exam-answer-container {
    min-height: 100vh;
    background: #f5f7fa;
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  /* 顶部考试信息 */
  .exam-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
    padding: 20rpx;
    border-radius: 12rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  }
  
  .progress {
    font-size: 28rpx;
    color: #333333;
    font-weight: 500;
  }
  
  .timer {
    font-size: 28rpx;
    color: #F44336;
    font-weight: 500;
  }
  
  /* 题目卡片 */
  .question-card {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 40rpx 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
    margin-bottom: 30rpx;
  }
  
  .question-text {
    font-size: 32rpx;
    color: #333333;
    line-height: 1.6;
    margin-bottom: 40rpx;
  }
  
  /* 选项列表 */
  .options {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .option {
    padding: 25rpx;
    background: #f5f5f5;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #333333;
    transition: all 0.2s;
  }
  
  .option.selected {
    background: #4CAF50;
    color: #ffffff;
  }
  
  /* 底部按钮组 */
  .btn-group {
    display: flex;
    gap: 20rpx;
  }
  
  .prev-btn, .next-btn, .submit-btn {
    flex: 1;
    padding: 25rpx;
    border-radius: 12rpx;
    font-size: 28rpx;
  }
  
  .prev-btn {
    background: #eeeeee;
    color: #666666;
  }
  
  .next-btn {
    background: #4CAF50;
    color: #ffffff;
  }
  
  .submit-btn {
    background: #F44336;
    color: #ffffff;
  }