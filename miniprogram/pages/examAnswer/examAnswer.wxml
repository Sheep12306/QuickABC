<view class="exam-answer-container">
  <!-- 顶部考试信息 -->
  <view class="exam-header">
    <view class="progress">第{{currentIndex + 1}}题 / 共100题</view>
    <view class="timer">剩余时间：{{formatTime}}</view>
  </view>

  <!-- 题目区域 -->
  <view class="question-card">
    <view class="question-text">{{currentQuestion.question}}</view>
    <!-- 选项列表 -->
    <view class="options">
      <view 
        class="option {{selectedOption === opt ? 'selected' : ''}}" 
        wx:for="{{currentQuestion.options}}" 
        wx:key="*this"
        bindtap="selectOption"
        data-option="{{opt}}"
      >
        {{opt}}
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="btn-group">
    <button 
      wx:if="{{currentIndex > 0}}"
      bindtap="prevQuestion"
      class="prev-btn"
    >上一题</button>
    <button 
      wx:if="{{currentIndex < 99}}"
      bindtap="nextQuestion"
      class="next-btn"
    >下一题</button>
    <button 
      wx:if="{{currentIndex === 99}}"
      bindtap="submitExam"
      class="submit-btn"
    >交卷</button>
  </view>
</view>