<view class="settings-container" style="background:{{cardThemes[themeIdx].bg}};">
  <!-- 通用设置 -->
  <view class="settings-group">
    <view class="settings-item" bindtap="clearCache">
      <view class="settings-icon-circle" style="background:{{themeColors[themeIdx].light}};">
        <text class="settings-icon-inner" style="color:{{themeColors[themeIdx].accent}};">D</text>
      </view>
      <text class="settings-label">清除缓存</text>
      <text class="settings-arrow">></text>
    </view>
    <view class="settings-item" bindtap="showAbout">
      <view class="settings-icon-circle" style="background:{{themeColors[themeIdx].light}};">
        <text class="settings-icon-inner" style="color:{{themeColors[themeIdx].accent}};">A</text>
      </view>
      <text class="settings-label">关于快背单词</text>
      <text class="settings-arrow">></text>
    </view>
    <view class="settings-item settings-item-last" bindtap="showFeedback">
      <view class="settings-icon-circle" style="background:{{themeColors[themeIdx].light}};">
        <text class="settings-icon-inner" style="color:{{themeColors[themeIdx].accent}};">F</text>
      </view>
      <text class="settings-label">意见反馈</text>
      <text class="settings-arrow">></text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">快背单词 v1.0.0</text>
    <text class="version-sub">Powered by WeChat Cloud</text>
  </view>
</view>
