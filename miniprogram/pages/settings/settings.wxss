/* 设置页 - 玻璃拟态 */

.settings-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.settings-group {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 0 28rpx;
  margin-bottom: 36rpx;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(46, 125, 50, 0.06);
}

.settings-item:active {
  opacity: 0.75;
}

.settings-item-last {
  border-bottom: none;
}

.settings-icon-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.settings-icon-inner {
  font-size: 24rpx;
  font-weight: 700;
}

.settings-label {
  flex: 1;
  font-size: 30rpx;
  color: #2C3E2D;
  font-weight: 500;
}

.settings-arrow {
  font-size: 28rpx;
  color: #B0B8B0;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #A5B8A5;
  display: block;
  margin-bottom: 6rpx;
}

.version-sub {
  font-size: 22rpx;
  color: #C0C8C0;
}
