/* 学习页面样式 */
.learn-container {
    min-height: 100vh;
    background: #F8F8FA;
}

/* 顶部导航栏 */
.learn-header {
    padding: 20rpx 32rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 10;
    background: #F8F8FA;
}

.nav-left {
    display: flex;
    align-items: baseline;
    gap: 12rpx;
}

.book-name {
    font-size: 26rpx;
    font-weight: 500;
    color: #8A9B8B;
}

.group-text {
    font-size: 36rpx;
    font-weight: 700;
    color: #2C3E2D;
}

.today-badge {
    font-size: 24rpx;
    font-weight: 400;
    color: #8A9B8B;
}

.nav-right {
    display: flex;
    align-items: center;
}

.nav-review {
    display: flex;
    align-items: center;
    padding: 14rpx 28rpx;
    border-radius: 20rpx;
    border: 1rpx solid;
    background: #E8F5E9;
}

.nav-review:active {
    opacity: 0.7;
}

.review-text {
    font-size: 26rpx;
    color: #43A047;
    font-weight: 500;
}

/* 单词列表区 */
.words-section {
    padding: 32rpx 28rpx 120rpx;
}

.word-card {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
    border: 2rpx solid #E8F5E9;
}

.word-card:active {
    background: #F9F9F9;
}

.word-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.word-en {
    font-size: 44rpx;
    font-weight: 700;
    color: #1A1A1A;
}

.word-phonetic {
    font-size: 28rpx;
    font-weight: 500;
}

.word-info {
    overflow: hidden;
}

.word-info.show {
    max-height: 100rpx;
    opacity: 1;
}

.word-info.hide {
    max-height: 0;
    opacity: 0;
}

.word-part {
    display: flex;
    align-items: center;
    padding: 15rpx 0;
}

.part-meaning {
    font-size: 32rpx;
    color: #4A4A4A;
}

/* 点击指示器 */
.click-indicator {
    display: flex;
    justify-content: center;
    gap: 15rpx;
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #E5E5EA;
}

.indicator-dot {
    width: 20rpx;
    height: 20rpx;
    background: #E5E5EA;
    border-radius: 50%;
}

.indicator-dot.active {
    transform: scale(1.2);
}

/* 底部控制栏 */
.bottom-controls {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #FFFFFF;
    padding: 20rpx 28rpx;
    border-top: 1rpx solid #E5E5EA;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.btn-control {
    border-radius: 20rpx;
    padding: 20rpx 36rpx;
    font-size: 28rpx;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 200rpx;
    background: #E8E8E8;
    color: #555555;
}

.btn-control:active {
    opacity: 0.8;
}

.btn-control.disabled {
    background: #EBEDF0 !important;
    color: #C0C4C0 !important;
}

