/* 抗遗忘复习列表 */

.mode-container {
  min-height: 100vh;
  background: linear-gradient(175deg, #C8E6C9 0%, #E8F5E9 30%, #F1F8F4 100%);
  display: flex;
  flex-direction: column;
}

.mode-top {
  padding: 28rpx 36rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}

.mode-scroll {
  flex: 1;
  padding: 0 32rpx;
}

.mode-card {
  background: rgba(255, 255, 255, 0.65);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 2rpx 12rpx rgba(46, 125, 50, 0.05);
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mode-card:active {
  opacity: 0.8;
}

.mode-card-left {
  flex: 1;
  min-width: 0;
}

.mode-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}

.mode-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.mode-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  width: 100rpx;
}

.mode-tag {
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mode-tag-num {
  font-size: 28rpx;
  font-weight: 700;
}

.mode-status {
  padding: 6rpx 0;
  border-radius: 16rpx;
  width: 100%;
  text-align: center;
  flex-shrink: 0;
}

.mode-status.checked {
  background: #E8F5E9;
}

.mode-status.unchecked {
  background: #F2F2F7;
}

.mode-status-text {
  font-size: 24rpx;
  font-weight: 500;
}

.mode-status.checked .mode-status-text {
  color: #43A047;
}

.mode-status.unchecked .mode-status-text {
  color: #999;
}

.scroll-bottom-space {
  height: 40rpx;
}

.mode-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #8A9B8B;
}
