/* 抗遗忘复习列表 */

.mode-container {
  min-height: 100vh;
  background: linear-gradient(175deg, #C8E6C9 0%, #E8F5E9 30%, #F1F8F4 100%);
  display: flex;
  flex-direction: column;
}

.mode-top {
  padding: 28rpx 32rpx;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}

.mode-scroll {
  flex: 1;
  padding: 0 28rpx;
}

.mode-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 18rpx rgba(46, 125, 50, 0.06);
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mode-card:active {
  opacity: 0.85;
}

.mode-card-left {
  flex: 1;
}

.mode-date {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E2D;
  display: block;
}

.mode-count {
  font-size: 24rpx;
  color: #8A9B8B;
  margin-top: 6rpx;
}

.mode-card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.mode-tag {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-tag-num {
  font-size: 28rpx;
  font-weight: 700;
}

.mode-status {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.mode-status.checked {
  background: #E8F5E9;
}

.mode-status.unchecked {
  background: #F2F2F7;
}

.mode-status-text {
  font-size: 22rpx;
  font-weight: 500;
}

.mode-status.checked .mode-status-text {
  color: #43A047;
}

.mode-status.unchecked .mode-status-text {
  color: #8A9B8B;
}

.scroll-bottom-space {
  height: 40rpx;
}

.mode-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #8A9B8B;
}
