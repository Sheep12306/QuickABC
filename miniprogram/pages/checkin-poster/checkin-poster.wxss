.poster-bg {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}
.poster-title-row {
  text-align: center;
  margin-bottom: 28rpx;
}
.poster-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E2D;
  display: block;
}
.poster-sub {
  font-size: 26rpx;
  color: #6A7B6B;
  margin-top: 8rpx;
  display: block;
}
.canvas-wrap {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(46,125,50,0.1);
  margin-bottom: 32rpx;
}
.poster-canvas {
  width: 100%;
  height: auto;
  opacity: 0;
  position: absolute;
  pointer-events: none;
}
.poster-preview {
  width: 100%;
  display: block;
}
.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.poster-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 24rpx;
  text-align: center;
}
.poster-btn:active { opacity: 0.85; }
.poster-btn.share-btn {
  background: rgba(255,255,255,0.5);
  border: 2rpx solid rgba(0,0,0,0.08);
  padding: 24rpx 0;
  line-height: 1;
  font-size: inherit;
}
.poster-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.poster-btn.share-btn .poster-btn-text { color: #4A5B4B; }
.poster-back {
  text-align: center;
  padding: 16rpx 0;
}
.poster-back-text {
  font-size: 26rpx;
  color: #8A9B8B;
}
