<view class="discover-container" style="background:{{cardThemes[themeIdx].bg}};">
  <!-- 功能入口 -->
  <view class="top-modules">
    <view class="module-card" bindtap="enterGrammarTrain">
      <view class="module-icon-circle grammar" style="background:{{themeColors[themeIdx].light}};">
        <text class="module-icon-inner" style="color:{{themeColors[themeIdx].accent}};">G</text>
      </view>
      <view class="module-title">语法训练</view>
      <view class="module-desc">专项突破难点</view>
    </view>
    <view class="module-card" bindtap="enterReadingTrain">
      <view class="module-icon-circle reading">
        <text class="module-icon-inner" style="color:#F0A050;">R</text>
      </view>
      <view class="module-title">阅读提升</view>
      <view class="module-desc">提升理解能力</view>
    </view>
    <view class="module-card" bindtap="enterExamSelect">
      <view class="module-icon-circle exam">
        <text class="module-icon-inner" style="color:#42A5F5;">E</text>
      </view>
      <view class="module-title">模拟考</view>
      <view class="module-desc">检验成果</view>
    </view>
  </view>

  <!-- 模拟考试 -->
  <view class="exam-module">
    <view class="exam-header">
      <view class="exam-title">模拟考试</view>
      <view class="exam-desc">100 道选择题速刷，全面检验学习成果</view>
    </view>
    <view class="exam-btn" bindtap="enterExamSelect" style="background:{{themeColors[themeIdx].accent}};">
      <text class="exam-btn-text">开始模拟考试</text>
    </view>
  </view>
</view>
