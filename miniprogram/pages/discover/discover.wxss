/* 发现页 - 玻璃拟态 */

.discover-container {
  min-height: 100vh;
  padding: 28rpx;
}

/* 顶部模块 */
.top-modules {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.module-card {
  background: rgba(255, 255, 255, 0.60);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 32rpx 18rpx;
  text-align: center;
}

.module-card:active {
  background: rgba(255, 255, 255, 0.78);
}

.module-icon-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.module-icon-circle.reading {
  background: rgba(255, 152, 0, 0.08);
}
.module-icon-circle.exam {
  background: rgba(33, 150, 243, 0.08);
}

.module-icon-inner {
  font-size: 28rpx;
  font-weight: 700;
}

.module-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
  margin-bottom: 6rpx;
}

.module-desc {
  font-size: 22rpx;
  color: #8A9B8B;
  line-height: 1.4;
}

/* 模拟考试大卡片 */
.exam-module {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 6rpx 30rpx rgba(46, 125, 50, 0.09);
  padding: 32rpx;
}

.exam-header {
  margin-bottom: 24rpx;
}

.exam-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E2D;
  margin-bottom: 8rpx;
}

.exam-desc {
  font-size: 26rpx;
  color: #6A7B6B;
  line-height: 1.5;
}

.exam-btn {
  width: 100%;
  border-radius: 24rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.18);
}

.exam-btn:active {
  opacity: 0.85;
}

.exam-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
