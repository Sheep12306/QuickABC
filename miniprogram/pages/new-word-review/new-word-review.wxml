<view class="review-container">
  <view class="review-top">
    <text class="review-title">错词本</text>
    <text class="review-subtitle">{{currentIndex + 1}}/{{totalWords || 0}}</text>
  </view>

  <view class="word-area">
    <view class="word-main" wx:if="{{currentWord}}">
      <view class="word-display">
        <text class="word-en">{{currentWord.en}}</text>
        <view class="word-meta">
          <text class="word-phonetic" style="color:{{themeColors[themeIdx].accent}};">[{{currentWord.phonetic}}]</text>
          <view class="audio-icon" bindtap="playCurrentAudio" style="background:{{themeColors[themeIdx].light}};">
            <view class="audio-shape" style="border-left-color:{{themeColors[themeIdx].accent}};"></view>
          </view>
        </view>
      </view>

      <view class="answer-area {{showAnswer ? 'show' : 'hide'}}">
        <view class="meaning-text">{{currentWord.part}} {{currentWord.meaning}}</view>
        <view class="correct-btn" wx:if="{{showAnswer && currentMarkedAsKnow}}" bindtap="correctToDontKnow">
          <text>更正为不认识</text>
        </view>
      </view>

      <view class="action-buttons" wx:if="{{!hasMadeChoice}}">
        <view class="btn-action btn-dont-know" bindtap="markDontKnow" hover-class="btn-active">
          <text>仍不认识</text>
        </view>
        <view class="btn-action btn-know" bindtap="markKnow" hover-class="btn-active" style="background:{{themeColors[themeIdx].accent}};">
          <text>已掌握</text>
        </view>
      </view>

      <view class="next-btn-area" wx:if="{{hasMadeChoice}}">
        <view class="btn-next" bindtap="nextWord" style="background:{{themeColors[themeIdx].accent}};">
          <text>{{currentIndex < totalWords - 1 ? '下一个' : '继续复习'}}</text>
        </view>
      </view>
    </view>
    <view class="empty-tip" wx:else>
      <text>暂无错词，继续加油！</text>
    </view>
  </view>

  <!-- 统计区 -->
  <view class="stats-section">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{knowCount || 0}}</text>
        <text class="stat-label">已掌握</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{totalWords || 0}}</text>
        <text class="stat-label">需复习</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="shuffleWords">
        <text class="stat-value" style="color:{{themeColors[themeIdx].accent}};">↻</text>
        <text class="stat-label">随机复习</text>
      </view>
    </view>
  </view>
</view>
