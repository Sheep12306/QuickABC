<view class="profile-container" style="background:{{cardThemes[themeIdx].bg}};">
  <!-- 头像区 -->
  <view class="avatar-card" bindtap="chooseAvatar">
    <image class="avatar-img" src="{{userInfo.avatar || '/images/avatar.png'}}" mode="aspectFill"></image>
    <view class="avatar-hint">
      <view class="avatar-hint-icon" style="background:{{themeColors[themeIdx].accent}};">
        <text class="avatar-plus">+</text>
      </view>
      <text class="avatar-hint-text">点击更换头像</text>
    </view>
  </view>

  <!-- 表单区 -->
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="请输入昵称" value="{{userInfo.nickname}}"
             bindinput="onNicknameInput" maxlength="20"/>
    </view>
    <view class="form-item">
      <text class="form-label">年级</text>
      <picker bindchange="onGradeChange" value="{{gradeIndex}}" range="{{gradeList}}">
        <view class="picker-display">
          <text class="{{gradeIndex >= 0 ? 'picker-selected' : 'picker-placeholder'}}">
            {{gradeIndex >= 0 ? gradeList[gradeIndex] : '请选择年级'}}
          </text>
          <text class="picker-arrow" style="color:{{themeColors[themeIdx].accent}};">></text>
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" value="{{userInfo.phone}}"
             bindinput="onPhoneInput" type="number" maxlength="11"/>
    </view>
    <view class="form-item form-item-last">
      <text class="form-label">学校</text>
      <input class="form-input" placeholder="请输入学校名称" value="{{userInfo.school}}"
             bindinput="onSchoolInput" maxlength="30"/>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn {{isSaving ? 'saving' : ''}}" bindtap="saveProfile"
        style="background:{{isSaving ? '#A5D6A7' : themeColors[themeIdx].accent}};">
    <text class="save-text">{{isSaving ? '保存中...' : '保存'}}</text>
  </view>
</view>
