/* 生词本 - 玻璃拟态 */

.vocab-container {
  min-height: 100vh;
  background: linear-gradient(175deg, #C8E6C9 0%, #E8F5E9 30%, #F1F8F4 100%);
  display: flex;
  flex-direction: column;
}

/* ===== 顶部行 ===== */
.vocab-top {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.vocab-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}

.top-spacer {
  flex: 1;
}

.top-action {
  margin-left: 28rpx;
  padding: 8rpx 0;
}

.top-action:active {
  opacity: 0.6;
}

.top-action-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx 20rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #2C3E2D;
}

.search-cancel {
  font-size: 26rpx;
  color: #8A9B8B;
  padding: 8rpx 12rpx;
}

/* ===== 统计行 ===== */
.vocab-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: #8A9B8B;
}

.stats-action {
  font-size: 24rpx;
  color: #8A9B8B;
}

.stats-action:active {
  opacity: 0.6;
}

/* ===== 生词列表 ===== */
.vocab-scroll {
  flex: 1;
  padding: 0 28rpx;
}

.vocab-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 18rpx rgba(46, 125, 50, 0.06);
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vocab-card-left {
  flex: 1;
}

.vocab-en {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E2D;
  display: block;
}

.vocab-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.vocab-phonetic {
  font-size: 24rpx;
  font-weight: 500;
}

.vocab-part {
  font-size: 22rpx;
  color: #8A9B8B;
  background: #F2F2F7;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.vocab-meaning {
  font-size: 28rpx;
  color: #4A5B4B;
  margin-top: 10rpx;
  display: block;
}

/* 右侧操作 */
.vocab-card-right {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.vocab-action {
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
}

.vocab-action:active {
  opacity: 0.7;
}

.vocab-action.mastered {
  background: #E8F5E9;
}

.vocab-action.delete {
  background: #F2F2F7;
}

.vocab-action-text {
  font-size: 22rpx;
  font-weight: 500;
}

.delete-text {
  color: #8A9B8B;
}

.scroll-bottom-space {
  height: 40rpx;
}

/* ===== 空状态 ===== */
.vocab-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.empty-icon-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon-text {
  font-size: 44rpx;
  font-weight: 700;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E2D;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8A9B8B;
  margin-bottom: 36rpx;
}

.empty-add-btn {
  padding: 20rpx 56rpx;
  border-radius: 28rpx;
}

.empty-add-btn:active {
  opacity: 0.85;
}

.empty-add-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 批量管理栏 ===== */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 36rpx;
  background: rgba(255, 255, 255, 0.75);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.batch-select-all {
  padding: 8rpx 16rpx;
}

.batch-all-text {
  font-size: 24rpx;
  color: #4A5B4B;
}

.batch-count {
  font-size: 24rpx;
  color: #8A9B8B;
}

.batch-delete-btn {
  padding: 10rpx 24rpx;
  background: #FFEBEE;
  border-radius: 16rpx;
}

.batch-delete-text {
  font-size: 24rpx;
  color: #E53935;
  font-weight: 500;
}

.batch-cancel {
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
}

.batch-cancel-text {
  font-size: 24rpx;
  color: #4A5B4B;
  font-weight: 500;
}

/* ===== 添加弹窗 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 99;
}

.add-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  z-index: 100;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C3E2D;
  display: block;
  margin-bottom: 28rpx;
  text-align: center;
}

.modal-input {
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2C3E2D;
  margin-bottom: 16rpx;
}

.modal-btns {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #F2F2F7;
  color: #8A9B8B;
}

.modal-btn.confirm {
  color: #FFFFFF;
}

.modal-btn:active {
  opacity: 0.8;
}
