<view class="test-bg" style="background:{{cardThemes[themeIdx].bg}};">

  <!-- 加载中 -->
  <view class="test-loading" wx:if="{{phase === 'loading'}}">
    <view class="loading-card">
      <text class="loading-text">正在生成测试题目...</text>
    </view>
  </view>

  <!-- 答题中 -->
  <view class="test-quiz" wx:if="{{phase === 'testing' && words.length > 0}}">
    <!-- 顶部进度 -->
    <view class="quiz-top">
      <text class="quiz-back" bindtap="goBack">← 退出</text>
      <text class="quiz-progress">{{currentIndex + 1}} / {{words.length}}</text>
      <view class="quiz-progress-bar">
        <view class="quiz-progress-fill" style="width:{{(currentIndex + 1) / words.length * 100}}%;background:{{themeColors[themeIdx].accent}};"></view>
      </view>
    </view>

    <!-- 单词卡片 -->
    <view class="quiz-card">
      <view class="quiz-book-tag" style="background:{{themeColors[themeIdx].light}};color:{{themeColors[themeIdx].accent}};">
        {{currentWord.bookName}}
      </view>
      <text class="quiz-word">{{currentWord.word}}</text>
      <text class="quiz-phonetic">{{currentWord.phonetic}}</text>
      <text class="quiz-meaning">{{currentWord.part}} {{currentWord.meaning}}</text>
    </view>

    <!-- 三个选择按钮 -->
    <view class="quiz-actions">
      <view class="quiz-btn dont-know {{answers[currentWord.id] === 'dontKnow' ? 'selected' : ''}}"
            data-answer="dontKnow" bindtap="selectAnswer"
            style="{{answers[currentWord.id] === 'dontKnow' ? 'background:#F44336;color:#fff;' : ''}}">
        <text class="quiz-btn-label">不认识</text>
      </view>
      <view class="quiz-btn fuzzy {{answers[currentWord.id] === 'fuzzy' ? 'selected' : ''}}"
            data-answer="fuzzy" bindtap="selectAnswer"
            style="{{answers[currentWord.id] === 'fuzzy' ? 'background:#FF9800;color:#fff;' : ''}}">
        <text class="quiz-btn-label">模糊</text>
      </view>
      <view class="quiz-btn know {{answers[currentWord.id] === 'know' ? 'selected' : ''}}"
            data-answer="know" bindtap="selectAnswer"
            style="{{answers[currentWord.id] === 'know' ? 'background:#43A047;color:#fff;' : ''}}">
        <text class="quiz-btn-label">认识</text>
      </view>
    </view>

    <!-- 上一题/下一题 -->
    <view class="quiz-nav">
      <view class="nav-btn {{currentIndex === 0 ? 'disabled' : ''}}" bindtap="prevWord">
        <text>← 上一题</text>
      </view>
      <view class="nav-btn {{currentIndex >= words.length - 1 ? 'disabled' : ''}}" bindtap="nextWord">
        <text>下一题 →</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-btn {{allAnswered ? '' : 'disabled'}}" bindtap="submitTest"
          style="{{allAnswered ? 'background:' + themeColors[themeIdx].accent + ';' : ''}}">
      <text class="submit-text">{{allAnswered ? '提交答案 (' + words.length + '/' + words.length + ')' : '请答完所有题目 (' + Object.keys(answers).length + '/' + words.length + ')'}}</text>
    </view>
  </view>

  <!-- 结果页 -->
  <view class="test-result" wx:if="{{phase === 'result'}}">
    <view class="result-header">
      <text class="result-title">测试结果</text>
      <text class="result-vocab" style="color:{{themeColors[themeIdx].accent}};">≈ {{estimatedVocab}}</text>
      <text class="result-vocab-label">估算词汇量</text>
    </view>

    <!-- 各难度认识率 -->
    <view class="result-books">
      <text class="result-section-title">各难度认识率</text>
      <view class="book-bar-item" wx:for="{{bookResults}}" wx:key="bookId">
        <view class="book-bar-info">
          <text class="book-bar-name">{{item.bookName}}</text>
          <text class="book-bar-rate" style="color:{{themeColors[themeIdx].accent}};">{{item.rate}}%</text>
        </view>
        <view class="book-bar-track">
          <view class="book-bar-fill" style="width:{{item.rate}}%;background:{{themeColors[themeIdx].accent}};"></view>
        </view>
        <text class="book-bar-detail">{{item.score}} / {{item.count}} · 贡献 {{item.contribution}} 词</text>
      </view>
    </view>

    <!-- 推荐词书 -->
    <view class="result-recommend" wx:if="{{recommendations.length > 0}}">
      <text class="result-section-title">推荐学习</text>
      <view class="recommend-item" wx:for="{{recommendations}}" wx:key="bookId">
        <text class="recommend-name">{{item.bookName}}</text>
        <text class="recommend-tip" style="color:{{themeColors[themeIdx].accent}};">认识率 {{item.rate}}%，建议优先学习</text>
      </view>
    </view>

    <view class="result-actions">
      <view class="retry-btn" bindtap="retryTest" style="background:{{themeColors[themeIdx].accent}};">
        <text class="retry-text">重新测试</text>
      </view>
      <view class="back-btn" bindtap="goBack">
        <text class="back-text">返回</text>
      </view>
    </view>
  </view>

</view>
