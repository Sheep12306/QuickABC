<view class="test-bg" style="background:{{cardThemes[themeIdx].bg}};">

  <!-- 加载中 -->
  <view class="test-loading" wx:if="{{phase === 'loading'}}">
    <view class="loading-card">
      <text class="loading-text">正在生成测试题目...</text>
    </view>
  </view>

  <!-- 答题中 -->
  <view class="test-quiz" wx:if="{{phase === 'testing' && currentWord}}">
    <!-- 顶部进度 -->
    <view class="quiz-top">
      <text class="quiz-progress">{{currentIndex + 1}} / {{words.length}}</text>
      <view class="quiz-progress-bar">
        <view class="quiz-progress-fill" style="width:{{(currentIndex + 1) / words.length * 100}}%;background:{{themeColors[themeIdx].accent}};"></view>
      </view>
      <text class="quiz-accuracy-hint">已答 {{answeredCount}} 题，测越多越准</text>
    </view>

    <!-- 单词卡片 -->
    <view class="quiz-card {{showMeaning ? 'revealed' : ''}}">
      <text class="quiz-word">{{currentWord.word}}</text>
      <text class="quiz-phonetic" style="color:{{themeColors[themeIdx].accent}};">[{{currentWord.phonetic}}]</text>

      <!-- 答完后显示意思 -->
      <view class="quiz-reveal" wx:if="{{showMeaning}}">
        <view class="reveal-divider"></view>
        <text class="quiz-meaning">{{currentWord.part}} {{currentWord.meaning}}</text>
      </view>
    </view>

    <!-- 三个选择按钮（未作答时显示） -->
    <view class="quiz-actions" wx:if="{{!showMeaning}}">
      <view class="quiz-btn dont-know" data-answer="dontKnow" bindtap="selectAnswer">
        <text class="quiz-btn-label">不认识</text>
      </view>
      <view class="quiz-btn fuzzy" data-answer="fuzzy" bindtap="selectAnswer">
        <text class="quiz-btn-label">模糊</text>
      </view>
      <view class="quiz-btn know" data-answer="know" bindtap="selectAnswer">
        <text class="quiz-btn-label">认识</text>
      </view>
    </view>

    <!-- 已作答状态提示 -->
    <view class="quiz-answered" wx:if="{{showMeaning}}">
      <text class="answered-label">你的选择：</text>
      <text class="answered-tag {{lastAnswer}}" style="{{lastAnswer === 'know' ? 'background:#43A047;color:#fff;' : lastAnswer === 'fuzzy' ? 'background:#FF9800;color:#fff;' : 'background:#F44336;color:#fff;'}}">{{lastAnswer === 'know' ? '✓ 认识' : lastAnswer === 'fuzzy' ? '~ 模糊' : '✗ 不认识'}}</text>
    </view>
  </view>

  <!-- 30词中转站 -->
  <view class="test-checkpoint" wx:if="{{phase === 'checkpoint'}}">
    <view class="checkpoint-card">
      <text class="checkpoint-icon">🎯</text>
      <text class="checkpoint-title">已测试 {{answeredCount}} 个单词</text>
      <text class="checkpoint-desc">测的单词越多，词汇量估算越准确。还剩 {{words.length - answeredCount}} 个词未测。</text>
      <view class="checkpoint-actions">
        <view class="checkpoint-btn stop" bindtap="stopAndSubmit">
          <text class="checkpoint-btn-text">就测到这里</text>
        </view>
        <view class="checkpoint-btn goon" bindtap="continueTest" style="background:{{themeColors[themeIdx].accent}};">
          <text class="checkpoint-btn-text" style="color:#fff;">继续测试</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 结果页 -->
  <view class="test-result" wx:if="{{phase === 'result'}}">
    <view class="result-header">
      <text class="result-badge" style="color:{{themeColors[themeIdx].accent}};">{{levelBadge}}</text>
      <text class="result-title">{{levelName}}</text>
      <text class="result-vocab" style="color:{{themeColors[themeIdx].accent}};">≈ {{estimatedVocab}}</text>
      <text class="result-vocab-label">估算词汇量 · 基于 {{totalCount}} 个单词</text>
    </view>

    <!-- 各难度认识率 -->
    <view class="result-books">
      <text class="result-section-title">各阶段认识率</text>
      <view class="book-bar-item" wx:for="{{bookResults}}" wx:key="bookId">
        <view class="book-bar-info">
          <text class="book-bar-name">{{item.bookName}}</text>
          <text class="book-bar-rate" style="color:{{themeColors[themeIdx].accent}};">{{item.rate}}%</text>
        </view>
        <view class="book-bar-track">
          <view class="book-bar-fill" style="width:{{item.rate}}%;background:{{item.rate >= 80 ? '#43A047' : item.rate >= 50 ? '#FF9800' : '#F44336'}};"></view>
        </view>
      </view>
    </view>

    <!-- 推荐词书 -->
    <view class="result-recommend" wx:if="{{recommendations.length > 0}}">
      <text class="result-section-title">推荐学习</text>
      <view class="recommend-item" wx:for="{{recommendations}}" wx:key="bookId">
        <text class="recommend-name">{{item.bookName}}</text>
        <text class="recommend-tip" style="color:{{themeColors[themeIdx].accent}};">认识率 {{item.rate}}%</text>
      </view>
    </view>

    <view class="result-actions">
      <view class="retry-btn" bindtap="retryTest" style="background:{{themeColors[themeIdx].accent}};">
        <text class="retry-text">重新测试</text>
      </view>
      <view class="back-btn" bindtap="goBack">
        <text class="back-text">返回</text>
      </view>
    </view>
  </view>

</view>
