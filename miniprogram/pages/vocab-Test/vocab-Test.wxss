/* 词汇量测试 - 玻璃拟态 */

.test-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.test-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.08);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 48rpx;
}

.test-tip {
  font-size: 30rpx;
  color: #8A9B8B;
}

.complete-btn {
  padding: 24rpx 56rpx;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.16);
}

.complete-btn:active {
  opacity: 0.85;
}

.complete-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}
