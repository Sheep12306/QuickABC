/* 词汇测试页 */
.test-bg {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

/* ===== 加载中 ===== */
.test-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}
.loading-card {
  background: rgba(255,255,255,0.62);
  border-radius: 28rpx;
  padding: 60rpx 56rpx;
}
.loading-text {
  font-size: 30rpx;
  color: #8A9B8B;
}

/* ===== 答题区 ===== */
.quiz-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.quiz-back {
  font-size: 26rpx;
  color: #8A9B8B;
  flex-shrink: 0;
}
.quiz-progress {
  font-size: 24rpx;
  color: #6A7B6B;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}
.quiz-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(0,0,0,0.06);
  overflow: hidden;
}
.quiz-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* 单词卡片 */
.quiz-card {
  background: rgba(255,255,255,0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 4rpx 24rpx rgba(46,125,50,0.06);
  padding: 52rpx 36rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.quiz-book-tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}
.quiz-word {
  font-size: 64rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.quiz-phonetic {
  font-size: 28rpx;
  color: #8A9B8B;
  margin-bottom: 12rpx;
}
.quiz-meaning {
  font-size: 30rpx;
  color: #4A5B4B;
  font-weight: 500;
  text-align: center;
}

/* 三个选择按钮 */
.quiz-actions {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.quiz-btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.quiz-btn:active {
  opacity: 0.75;
  transform: scale(0.96);
}
.quiz-btn.dont-know {
  background: rgba(244,67,54,0.08);
  border: 2rpx solid rgba(244,67,54,0.25);
}
.quiz-btn.fuzzy {
  background: rgba(255,152,0,0.08);
  border: 2rpx solid rgba(255,152,0,0.25);
}
.quiz-btn.know {
  background: rgba(67,160,71,0.08);
  border: 2rpx solid rgba(67,160,71,0.25);
}
.quiz-btn-label {
  font-size: 28rpx;
  font-weight: 600;
}
.quiz-btn.dont-know .quiz-btn-label { color: #F44336; }
.quiz-btn.fuzzy .quiz-btn-label { color: #FF9800; }
.quiz-btn.know .quiz-btn-label { color: #43A047; }

/* 导航 */
.quiz-nav {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.nav-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #4A5B4B;
  background: rgba(255,255,255,0.5);
  border-radius: 16rpx;
}
.nav-btn:active { opacity: 0.6; }
.nav-btn.disabled { opacity: 0.3; pointer-events: none; }

/* 提交 */
.submit-btn {
  padding: 24rpx 0;
  border-radius: 24rpx;
  text-align: center;
  background: rgba(138,155,139,0.3);
}
.submit-btn.disabled { opacity: 0.5; }
.submit-btn:active { opacity: 0.85; }
.submit-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 结果页 ===== */
.result-header {
  background: rgba(255,255,255,0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255,255,255,0.65);
  box-shadow: 0 4rpx 24rpx rgba(46,125,50,0.06);
  padding: 44rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 28rpx;
  color: #6A7B6B;
  margin-bottom: 12rpx;
}
.result-vocab {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 8rpx;
}
.result-vocab-label {
  font-size: 26rpx;
  color: #8A9B8B;
}

/* 各难度认识率 */
.result-books {
  background: rgba(255,255,255,0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 3rpx 16rpx rgba(46,125,50,0.06);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.result-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2C3E2D;
  margin-bottom: 20rpx;
  display: block;
}
.book-bar-item {
  margin-bottom: 20rpx;
}
.book-bar-item:last-child { margin-bottom: 0; }
.book-bar-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.book-bar-name {
  font-size: 26rpx;
  color: #2C3E2D;
}
.book-bar-rate {
  font-size: 26rpx;
  font-weight: 600;
}
.book-bar-track {
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(0,0,0,0.05);
  overflow: hidden;
  margin-bottom: 6rpx;
}
.book-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}
.book-bar-detail {
  font-size: 22rpx;
  color: #B0B8B0;
}

/* 推荐词书 */
.result-recommend {
  background: rgba(255,255,255,0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 3rpx 16rpx rgba(46,125,50,0.06);
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}
.recommend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(46,125,50,0.06);
}
.recommend-item:last-child { border-bottom: none; }
.recommend-name {
  font-size: 26rpx;
  color: #2C3E2D;
}
.recommend-tip {
  font-size: 24rpx;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
}
.retry-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(46,125,50,0.16);
}
.retry-btn:active { opacity: 0.85; }
.retry-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}
.back-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 24rpx;
  text-align: center;
  background: rgba(255,255,255,0.5);
}
.back-btn:active { opacity: 0.7; }
.back-text {
  font-size: 30rpx;
  color: #4A5B4B;
  font-weight: 500;
}
