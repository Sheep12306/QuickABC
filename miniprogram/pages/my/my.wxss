/* 我的 - 玻璃拟态 */

.my-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

/* ===== 1. 用户信息 ===== */
.user-info-section {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.08);
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.avatar-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #D1D1D6;
  margin-right: 20rpx;
}

.user-base {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C3E2D;
  margin-bottom: 4rpx;
}

.user-level {
  font-size: 24rpx;
  font-weight: 500;
}

.phone-bind-text {
  font-size: 24rpx;
  color: #8A9B8B;
  margin-top: 6rpx;
}

.onekey-login-btn {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-top: 6rpx;
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.2);
}

.onekey-login-btn:active {
  opacity: 0.85;
}

.login-btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.personal-page {
  font-size: 26rpx;
  color: #6A7B8B;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: rgba(232, 245, 233, 0.45);
}

/* ===== 2. 核心数据 三栏 ===== */
.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.62);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 20rpx rgba(46, 125, 50, 0.07);
  padding: 36rpx 16rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-card:active {
  opacity: 0.8;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #8A9B8B;
  font-weight: 500;
}

/* ===== 3. 学习工具 ===== */
/* ===== 3. 学习工具 ===== */
.tools-section {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 24rpx 16rpx 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6A7B6B;
  padding: 0 12rpx 20rpx;
  display: block;
}

.tools-grid {
  display: flex;
  justify-content: space-around;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 16rpx;
}

.tool-item:active {
  opacity: 0.65;
}

.tool-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon-inner {
  font-size: 32rpx;
  font-weight: 700;
}

.tool-label {
  font-size: 24rpx;
  color: #4A5B4B;
  font-weight: 500;
}

/* ===== 5. 我的数据 ===== */
.data-list-section {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}

.data-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(46, 125, 50, 0.06);
}

.data-list-item:active {
  opacity: 0.75;
}

.data-list-item-last {
  border-bottom: none;
}

.dl-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.dl-icon-circle.wrong-icon {
  background: rgba(240, 160, 80, 0.10);
}

.dl-icon-circle.wrong-icon .dl-icon-inner {
  color: #F0A050;
}

.dl-icon-circle.dictation-icon {
  background: rgba(66, 165, 245, 0.10);
}

.dl-icon-circle.dictation-icon .dl-icon-inner {
  color: #42A5F5;
}

.dl-icon-inner {
  font-size: 26rpx;
  font-weight: 700;
}

.dl-label {
  flex: 1;
  font-size: 28rpx;
  color: #2C3E2D;
  font-weight: 500;
}

.dl-value {
  font-size: 24rpx;
  color: #8A9B8B;
  margin-right: 8rpx;
}

.dl-arrow {
  font-size: 26rpx;
  color: #B0B8B0;
}

/* ===== 6. 设置 ===== */
.setting-section {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(46, 125, 50, 0.06);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  opacity: 0.75;
}

.setting-icon-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.setting-icon-circle.config {
  background: rgba(138, 155, 139, 0.10);
}

.setting-icon-inner {
  font-size: 24rpx;
  font-weight: 700;
}

.config-icon {
  color: #8A9B8B;
}

.setting-name {
  flex: 1;
  font-size: 30rpx;
  color: #2C3E2D;
  font-weight: 500;
}

.setting-value {
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 8rpx;
}

.setting-arrow {
  font-size: 28rpx;
  color: #B0B8B0;
}

/* ===== 7. 主题脚注 ===== */
.theme-footer {
  text-align: center;
  padding: 20rpx 0 36rpx;
}

.theme-foot-text {
  font-size: 22rpx;
  color: #A5B8A5;
}
