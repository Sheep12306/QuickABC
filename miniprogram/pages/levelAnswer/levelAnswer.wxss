.answer-container {
    min-height: 100vh;
    background: #f5f7fa;
    box-sizing: border-box;
  }
  
  /* 顶部关卡信息 */
  .level-header {
    display: flex;
    align-items: center;
    background: #4CAF50;
    padding: 20rpx;
    color: #ffffff;
  }
  .back-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 28rpx;
    padding: 0 10rpx;
  }
  .level-info {
    flex: 1;
    text-align: center;
  }
  .level-name {
    font-size: 32rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 5rpx;
  }
  .progress {
    font-size: 24rpx;
    opacity: 0.9;
  }
  
  /* 题目容器 */
  .question-container {
    padding: 30rpx 20rpx;
    height: calc(100vh - 100rpx);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .question-card {
    width: 100%;
    background: #ffffff;
    border-radius: 16rpx;
    padding: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  }
  
  /* 题目文本 */
  .question-text {
    font-size: 32rpx;
    color: #333333;
    line-height: 1.6;
    margin-bottom: 40rpx;
  }
  
  /* 选择题选项 */
  .options {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-bottom: 40rpx;
  }
  .option {
    padding: 25rpx;
    background: #f5f5f5;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #333333;
    transition: all 0.2s;
  }
  .option.selected {
    background: #4CAF50;
    color: #ffffff;
  }
  
  /* 填空题输入框 */
  .fill-input {
    margin-bottom: 40rpx;
  }
  .fill-input input {
    width: 100%;
    padding: 25rpx;
    background: #f5f5f5;
    border-radius: 12rpx;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  /* 按钮组 */
  .btn-group {
    display: flex;
    gap: 20rpx;
  }
  .prev-btn, .next-btn, .submit-btn {
    flex: 1;
    padding: 25rpx;
    border-radius: 12rpx;
    font-size: 28rpx;
  }
  .prev-btn {
    background: #eeeeee;
    color: #666666;
  }
  .next-btn, .submit-btn {
    background: #4CAF50;
    color: #ffffff;
  }
  .next-btn[disabled], .submit-btn[disabled] {
    background: #cccccc;
    color: #999999;
  }