/* 词汇量详情 - 玻璃拟态 */

.detail-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

/* 分数卡片 */
.score-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.08);
  padding: 48rpx 20rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 28rpx;
  color: #6A7B6B;
  margin-bottom: 12rpx;
}

.score-num {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 28rpx;
}

.test-btn {
  padding: 20rpx 52rpx;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.16);
}

.test-btn:active {
  opacity: 0.85;
}

.test-btn-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 历史记录卡片 */
.history-card {
  background: rgba(255, 255, 255, 0.58);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 3rpx 16rpx rgba(46, 125, 50, 0.06);
  padding: 28rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
  margin-bottom: 16rpx;
  display: block;
}

.no-history {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #8A9B8B;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(46, 125, 50, 0.06);
}

.history-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.test-time {
  font-size: 26rpx;
  color: #2C3E2D;
}

.test-desc {
  font-size: 22rpx;
  color: #8A9B8B;
}

.test-score {
  font-size: 28rpx;
  font-weight: 500;
}
