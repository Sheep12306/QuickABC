/* 学习设置 - 玻璃拟态 */

.setting-container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 4rpx 24rpx rgba(46, 125, 50, 0.08);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.setting-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.setting-icon {
  font-size: 40rpx;
  font-weight: 700;
}

.setting-tip {
  font-size: 30rpx;
  color: #2C3E2D;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.setting-sub {
  font-size: 24rpx;
  color: #8A9B8B;
}
