@import '../review-mode/review-mode.wxss';

.go-btn {
  padding: 16rpx 32rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.go-btn:active {
  opacity: 0.85;
}

.go-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.mode-empty-sub {
  font-size: 24rpx;
  color: #A5B8A5;
  margin-top: 12rpx;
}
