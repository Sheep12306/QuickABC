/* ===== 首页 - 玻璃拟态 ===== */

/* 页面背景层 */
.home-bg {
  min-height: 100vh;
  background: linear-gradient(175deg, #C8E6C9 0%, #E8F5E9 30%, #F1F8F4 60%, #F5FAF5 100%);
  position: relative;
  overflow: hidden;
}

/* 顶部软光晕 */
.home-bg::before {
  content: '';
  position: fixed;
  top: -80rpx;
  left: -120rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(102, 187, 106, 0.18) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.home-bg::after {
  content: '';
  position: fixed;
  bottom: 200rpx;
  right: -100rpx;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(129, 199, 132, 0.14) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 页面内容 */
.home-content {
  position: relative;
  z-index: 1;
  padding: 0 28rpx 40rpx;
}

/* ===== 顶部问候气泡 ===== */
.greeting-bubble {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  background: rgba(67, 160, 71, 0.10);
  border-radius: 28rpx;
}

.greeting-bubble-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #43A047;
}

/* ===== 主学习卡片（放大 + 玻璃拟态） ===== */
.main-card {
  background: rgba(255, 255, 255, 0.62);
  border-radius: 52rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 36rpx rgba(46, 125, 50, 0.09), 0 2rpx 8rpx rgba(46, 125, 50, 0.04);
  padding: 52rpx 44rpx 46rpx;
  margin-bottom: 36rpx;
  overflow: hidden;
  position: relative;
}

/* 卡片内柔光 */
.main-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(67, 160, 71, 0.06) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 主卡上部：用户信息行 */
.main-card-header {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.main-user-info {
  flex: 1;
}

.main-user-meta {
  font-size: 26rpx;
  color: #6A7B6B;
  margin-top: 10rpx;
}

.main-progress-right {
  text-align: right;
  flex-shrink: 0;
}

.main-progress-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #43A047;
  display: block;
  line-height: 1;
}

.main-progress-label {
  font-size: 22rpx;
  color: #8A9B8B;
  margin-top: 4rpx;
}

/* ===== 歌词区 ===== */
.lyric-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: 28rpx 0;
  min-height: 280rpx;
}

.lyric-line {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.4s ease;
}

.lyric-word-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
}

.lyric-word {
  font-size: 34rpx;
  color: #C0C4C0;
  font-weight: 400;
  letter-spacing: 3rpx;
}

.lyric-phonetic {
  font-size: 22rpx;
  color: #B0B8B0;
}

.lyric-trans {
  font-size: 26rpx;
  color: #CCCFCC;
  font-weight: 400;
  max-width: 500rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 中间行高亮 */
.lyric-line.active {
  transform: scale(1.12);
}

.lyric-word.active {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.lyric-trans.active {
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
}

/* 主卡中部：词书信息 */
.book-info-row {
  margin-top: 44rpx;
  padding: 0 4rpx;
  position: relative;
  z-index: 2;
}

.book-name-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 22rpx;
}

.book-info-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E2D;
}

.book-percent {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 12rpx;
  margin-right: auto;
}

.book-switch-btn {
  padding: 6rpx 18rpx;
  background: rgba(67, 160, 71, 0.10);
  border-radius: 16rpx;
  border: 1rpx solid rgba(67, 160, 71, 0.15);
}

.book-switch-btn:active {
  background: rgba(67, 160, 71, 0.20);
}

.book-switch-text {
  font-size: 22rpx;
  color: #43A047;
  font-weight: 500;
}

.book-progress-wrapper {
  width: 100%;
}

.book-progress-bar {
  width: 100%;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.progress-left {
  font-size: 22rpx;
  color: #8A9B8B;
}

.progress-right {
  font-size: 22rpx;
  color: #8A9B8B;
}

/* ===== 播放器控制区 ===== */
.player-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 88rpx;
  margin-top: 48rpx;
  padding: 12rpx 0;
  position: relative;
  z-index: 2;
}

/* 左右侧按钮 */
.player-side {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}
.player-side:active {
  opacity: 0.5;
}

/* skip 图标：竖线 + 三角形 */
.skip-icon {
  display: flex;
  align-items: center;
  gap: 0;
}

.skip-bar {
  width: 6rpx;
  height: 44rpx;
  background: #8A9B8B;
  border-radius: 3rpx;
}

.skip-tri {
  width: 0;
  height: 0;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
}
.skip-prev .skip-tri {
  border-right: 20rpx solid #8A9B8B;
}
.skip-next .skip-tri {
  border-left: 20rpx solid #8A9B8B;
}

/* ===== 中央播放三角（无圆形容器） ===== */
.player-main {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}
.player-main:active {
  opacity: 0.7;
  transform: scale(0.9);
}

.play-triangle {
  width: 0;
  height: 0;
  border-top: 48rpx solid transparent;
  border-bottom: 48rpx solid transparent;
  border-left: 72rpx solid #43A047;
}

/* ===== 卡片内分割线 ===== */
.card-divider {
  height: 1rpx;
  background: rgba(46, 125, 50, 0.08);
  margin: 36rpx 0 28rpx;
}

/* ===== 四个功能入口（内嵌，无卡片背景） ===== */
.feature-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx;
}
.feature-item:active {
  opacity: 0.65;
}

.feature-icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-circle.review {
  background: rgba(67, 160, 71, 0.10);
}
.feature-icon-circle.wrong {
  background: rgba(255, 152, 0, 0.08);
}
.feature-icon-circle.dictation {
  background: rgba(33, 150, 243, 0.08);
}
.feature-icon-circle.vocab {
  background: rgba(156, 39, 176, 0.07);
}

.feature-icon-inner {
  font-size: 30rpx;
  font-weight: 700;
}

.feature-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #4A5B4B;
}

