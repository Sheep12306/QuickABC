<view class="home-bg" style="background:{{cardThemes[cardThemeIndex].bg}};">
  <view class="home-content">

    <!-- 顶部问候区 -->
    <view class="greeting-section">
      <view class="greeting-left">
        <text class="greeting-hi">嘿，{{userInfo.nickname || 'Lemon'}}</text>
        <view class="greeting-tag" style="background:{{cardThemes[cardThemeIndex].tagBg}};">
          <text class="greeting-tag-text" style="color:{{cardThemes[cardThemeIndex].accent}};">今天也要加油哦</text>
        </view>
      </view>
    </view>

    <!-- 主学习卡片（放大 + 动态背景） -->
    <view class="main-card" style="background:{{cardThemes[cardThemeIndex].cardBg}};">
      <view class="main-card-header">
        <view class="main-avatar">
          <text class="main-avatar-text">{{userInfo.nickname ? userInfo.nickname.substring(0, 2) : 'Lemon'}}</text>
        </view>
        <view class="main-user-info">
          <text class="main-user-name">英语学习者</text>
          <text class="main-user-meta">Lv.{{userLevel}}  已打卡 {{streakDays}} 天</text>
        </view>
        <view class="main-progress-right">
          <text class="main-progress-num" style="color:{{cardThemes[cardThemeIndex].accent}};">{{todayLearned}}/{{dailyGoal}}</text>
          <text class="main-progress-label">今日进度</text>
        </view>
      </view>

      <!-- 单词预览区 -->
      <view class="lyric-area">
        <view class="lyric-line {{item._index === previewStart + 1 ? 'active' : ''}}"
              wx:for="{{visibleWords}}" wx:key="word">
          <view class="lyric-word-row">
            <text class="lyric-word {{item._index === previewStart + 1 ? 'active' : ''}}"
                  style="{{item._index === previewStart + 1 ? 'color:' + cardThemes[cardThemeIndex].accent + ';' : ''}}">{{item.word}}</text>
          </view>
          <text class="lyric-trans {{item._index === previewStart + 1 ? 'active' : ''}}"
                style="{{item._index === previewStart + 1 ? 'color:' + cardThemes[cardThemeIndex].accent + ';' : ''}}">{{item.part}} {{item.meaning}}</text>
        </view>
      </view>

      <!-- 词书信息 -->
      <view class="book-info-row">
        <view class="book-name-row">
          <text class="book-info-name">{{currentBook.name || '小学单词汇总'}}</text>
          <text class="book-percent" style="color:{{cardThemes[cardThemeIndex].accent}};">{{currentBook.progress || 0}}%</text>
          <view class="book-switch-btn" bindtap="changeBook">
            <text class="book-switch-text" style="color:{{cardThemes[cardThemeIndex].accent}};">切换</text>
          </view>
        </view>
        <view class="book-progress-wrapper">
          <progress class="book-progress-bar" percent="{{currentBook.progress || 0}}"
                    stroke-width="6" activeColor="{{cardThemes[cardThemeIndex].accent}}" backgroundColor="rgba(67,160,71,0.10)"/>
          <view class="progress-labels">
            <text class="progress-left">已掌握 {{totalLearned || 0}}</text>
            <text class="progress-right">词书总词汇 {{currentBook.totalWords || 0}}</text>
          </view>
        </view>
      </view>

      <!-- 单词切换 + 播放控制区 -->
      <view class="player-row">
        <view class="player-side prev" bindtap="prevWord">
          <view class="skip-icon skip-prev">
            <view class="skip-bar" style="background:{{cardThemes[cardThemeIndex].accent}};"></view>
            <view class="skip-tri" style="border-right-color:{{cardThemes[cardThemeIndex].accent}};"></view>
          </view>
        </view>

        <view class="player-main" bindtap="startStudy">
          <view class="play-triangle" style="border-left-color:{{cardThemes[cardThemeIndex].accent}};"></view>
        </view>

        <view class="player-side next" bindtap="nextWord">
          <view class="skip-icon skip-next">
            <view class="skip-tri" style="border-left-color:{{cardThemes[cardThemeIndex].accent}};"></view>
            <view class="skip-bar" style="background:{{cardThemes[cardThemeIndex].accent}};"></view>
          </view>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="card-divider"></view>

      <!-- 四个功能入口（内嵌） -->
      <view class="feature-row">
        <view class="feature-item" bindtap="startReview">
          <view class="feature-icon-circle review">
            <text class="feature-icon-inner" style="color:#43A047;">R</text>
          </view>
          <text class="feature-name">复习</text>
        </view>
        <view class="feature-item" bindtap="startNewWords">
          <view class="feature-icon-circle wrong">
            <text class="feature-icon-inner" style="color:#F0A050;">W</text>
          </view>
          <text class="feature-name">错词本</text>
        </view>
        <view class="feature-item" bindtap="startTest">
          <view class="feature-icon-circle dictation">
            <text class="feature-icon-inner" style="color:#42A5F5;">D</text>
          </view>
          <text class="feature-name">听写</text>
        </view>
        <view class="feature-item" bindtap="goToVocabBook">
          <view class="feature-icon-circle vocab">
            <text class="feature-icon-inner" style="color:#AB47BC;">V</text>
          </view>
          <text class="feature-name">生词本</text>
        </view>
      </view>
    </view>

  </view>
</view>
